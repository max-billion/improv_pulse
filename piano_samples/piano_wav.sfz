// -------------------------------------------------------------
// University of Iowa Musical Instrument Samples (MIS)
// Steinway & Sons Model B Grand Piano
// Converted and mapped for standard SFZ samplers
// -------------------------------------------------------------

<control>
default_path=wav/

<global>
ampeg_attack=0.001
ampeg_release=1.200

